{
  "name": "bible-app",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration=production && npm run build:post",
    "build:post": "node scripts/write-build-info.mjs && node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "biome": "npx @biomejs/biome check --write --unsafe ./src",
    "cap:prune": "node scripts/prune-prerender-for-capacitor.mjs",
    "cap:sync": "npm run cap:prune && npx cap sync",
    "cap:icons": "node scripts/generate-splash-sources.mjs && npx @capacitor/assets generate --assetPath assets --android --ios --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#121212\"",
    "cap:ios": "npm run cap:prune && npx cap sync ios",
    "cap:android": "npm run cap:prune && npx cap sync android"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@angular/ssr": "^22.2.5",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@material-symbols/font-400": "^0.48.2",
    "@vercel/speed-insights": "^2.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@biomejs/biome": "^2.5.7",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "baseline-browser-mapping": "^2.11.34",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
