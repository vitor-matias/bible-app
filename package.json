{
  "name": "bible-app",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration=production && npm run build:post",
    "build:post": "node scripts/write-build-info.mjs && node scripts/generate-sitemap.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --code-coverage",
    "e2e": "playwright test",
    "biome": "npx @biomejs/biome check --write --unsafe ./src",
    "cap:prune": "node scripts/prune-prerender-for-capacitor.mjs",
    "cap:sync": "npm run cap:prune && npx cap sync",
    "cap:icons": "npx @capacitor/assets generate --assetPath assets --android --ios",
    "cap:ios": "npm run cap:prune && npx cap add ios && npx cap sync ios && npm run cap:icons",
    "cap:android": "npm run cap:prune && npx cap add android && npx cap sync android && npm run cap:icons"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/service-worker": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@material-symbols/font-400": "^0.45.10",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/localize": "^22.1.1",
    "@biomejs/biome": "^2.5.7",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.2.0",
    "baseline-browser-mapping": "^2.11.12",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "puppeteer": "^25.5.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "minimatch": "^3.1.5",
    "tar": "^7.5.22",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "@hono/node-server": "^2.0.5"
  }
}
